# ---------------------------------------------------------------------------
# Mental Toughness Clothing — environment
# Copy to .env.local for development. Set the same keys in Vercel for production.
# ---------------------------------------------------------------------------

# Canonical origin. Drives metadata, canonical URLs, sitemap, robots, JSON-LD.
# PLACEHOLDER — confirm the domain with the client (see CLIENT-TODO.md).
NEXT_PUBLIC_SITE_URL=https://mentaltoughnessclothing.shop

# --- Phase 1: email capture (waitlist, notify-me, contact form) ---------------
# https://resend.com/api-keys — without this key, submissions are logged to the
# server console and reported as successful in development only.
RESEND_API_KEY=

# Where waitlist / notify-me / contact submissions are delivered.
# Any working inbox is fine to start. PLACEHOLDER — the client has not named one.
WAITLIST_TO_EMAIL=
CONTACT_TO_EMAIL=

# The From address. Its domain must be verified in Resend or nothing sends.
CONTACT_FROM_EMAIL="Mental Toughness <hello@mentaltoughnessclothing.shop>"

# Optional: a Resend Audience to add waitlist contacts to (Resend > Audiences).
RESEND_AUDIENCE_ID=

# --- Phase 2: checkout + fulfilment (not used yet — see PHASE-2.md) ----------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=
# PRINTIFY_WEBHOOK_SECRET=
